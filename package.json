{
  "name": "netra",
  "version": "1.0.0",
  "description": "Netra desktop network diagnostics dashboard",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,green \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.netra.app",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "recharts": "^3.2.1",
    "speedtest-net": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.6",
    "wait-on": "^8.0.5"
  }
}
